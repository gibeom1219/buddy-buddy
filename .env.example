# Google Cloud 프로젝트 설정
GCP_PROJECT_ID=tst-gbseo-gcp
GCP_LOCATION=us-central1

# Cloud Run 배포 후 발급되는 서비스 URL (Google Chat 토큰 검증에 사용)
SERVICE_URL=https://buddy-buddy-64458639607.asia-northeast3.run.app

# 로컬 개발 시 development, 배포 시 production
NODE_ENV=development

# 서버 포트 (Cloud Run은 8080 사용)
PORT=8080

# Jira OAuth 설정
JIRA_BASE_URL=https://pim.cyberlogitec.com/jira
JIRA_CONSUMER_KEY=buddy-buddy
# RSA 개인키를 base64로 인코딩한 값 (아래 명령어로 생성)
# openssl genrsa -out jira_private.pem 2048
# cat jira_private.pem | base64 -w 0
JIRA_PRIVATE_KEY_BASE64=여기에_base64_인코딩된_RSA_개인키_입력
